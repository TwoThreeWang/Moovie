# ============================================================================
# Moovie 新系统配置示例
#
# 复制为 .env 后按需修改：cp .env.example .env
# 所有值都会被 TrimSpace；留空等同于不设置，会退回下面注释里写的默认值。
# 布尔项统一用字符串 "true"/"false"。
# 解析和校验逻辑见 internal/platform/config/config.go
# ============================================================================

# ---------------------------------------------------------------- 基础运行
# 运行环境，只能是 development / test / production 三者之一。
# production 会额外强制：SITE_URL 必须 https、APP_SECRET 必须替换。
APP_ENV=development
# HTTP 监听端口，不能为空。
PORT=5008
# 站点名称，用于页面标题和 SEO。
SITE_NAME=Moovie影牛
# 站点绝对地址，必须是完整的 http/https URL（结尾斜杠会被自动去掉）。
# 用于生成分享链接、sitemap 和回调地址，填错会导致外链指向错误域名。
SITE_URL=http://localhost:5008
# 静态资源与模板目录。
WEB_ROOT=./web
# 收到停止信号后等待在途请求结束的秒数，超时强制退出。
SHUTDOWN_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------- HTTP 限流与保护
# 突发流量保护：达到上限后最多排队 100ms，随后返回 503 + Retry-After，避免拖垮进程。
# 全站同时处理的请求数上限。上限 1024。
HTTP_MAX_IN_FLIGHT=64
# 重负载请求（搜索、聚合等）的并发上限，不能超过 HTTP_MAX_IN_FLIGHT。
HTTP_MAX_HEAVY_IN_FLIGHT=12
# 图片代理类请求的并发上限，不能超过 HTTP_MAX_IN_FLIGHT。
HTTP_MAX_IMAGE_IN_FLIGHT=24
# 并发满时请求的最长排队毫秒数，超时直接降载返回 503。
HTTP_QUEUE_TIMEOUT_MILLISECONDS=100
# 单个请求的处理超时秒数。
HTTP_REQUEST_TIMEOUT_SECONDS=30
# 请求体最大字节数，默认 1MiB。硬上限 16MiB。
HTTP_MAX_BODY_BYTES=1048576
# 请求头最大字节数，默认 64KiB。硬上限 1MiB。
HTTP_MAX_HEADER_BYTES=65536
# 最大 TCP 连接数。必须 >= HTTP_MAX_IN_FLIGHT，硬上限 8192。
HTTP_MAX_CONNECTIONS=512
# production 默认仅采样 10% 成功动态请求；错误、慢请求和降载按专用规则记录。
# 取值 0-100；development 默认 100。
HTTP_ACCESS_LOG_SAMPLE_PERCENT=10
# 即使采样命中，突发流量下每秒最多记录 20 条成功访问日志。硬上限 1000。
HTTP_ACCESS_LOG_MAX_PER_SECOND=20
# 出站请求对单个目标域名的最大连接数，防止爬采集站时打爆对方。硬上限 128。
OUTBOUND_MAX_CONNS_PER_HOST=12

# ---------------------------------------------------------------- 任务与 Worker
# 单进程部署保持 true；使用独立 cmd/worker 时 Web 设为 false=true。
JOBS_IN_WEB=false
# 独立 Worker 的 pending 任务轮询周期（秒）；手动同步通常在此时间内开始。
WORKER_POLL_SECONDS=2
# 统一任务队列的并发执行槽数量；资料、同步、热门和维护任务共享此预算。硬上限 64。
WORKER_CONCURRENCY=4

# ---------------------------------------------------------------- 搜索
# 搜索结果缓存只保留渲染字段，容量和并发扇出均设硬上限。
# 单个采集源的超时秒数，超时该源被丢弃但不影响其他源。
SEARCH_SOURCE_TIMEOUT_SECONDS=10
# 一次搜索所有源合计的总超时秒数。
SEARCH_TOTAL_TIMEOUT_SECONDS=30
# 本地已有结果时，最多再等上游刷新几秒；等不到就先返回本地结果，刷新继续在后台跑完。
# 调大 = 结果更全但页面更慢，调小 = 页面更快但新资源要下一次搜索才出现。
SEARCH_REFRESH_WAIT_SECONDS=3
# 搜索结果缓存有效期（分钟）。
SEARCH_CACHE_MINUTES=180
# 搜索结果缓存最多保留的条目数，超出按 LRU 淘汰。
# 搜索结果缓存条数。播放页每换一个线路都会生成一个新的缓存键，200 条很容易被挤掉，
# 挤掉就意味着下一次搜索又要重新跑一遍。一条大约几十 KB，500 条大约几十 MB 内存。
SEARCH_CACHE_ENTRIES=500
# 前台搜索同时请求的采集源数量上限。硬上限 64。
SEARCH_SOURCE_MAX_CONCURRENCY=6
# 后台补全/预热任务的并发上限。硬上限 64。
SEARCH_BACKGROUND_MAX_CONCURRENCY=8
# 采集源熔断器：连续失败的源会被临时摘除，恢复后自动放回。
SEARCH_BREAKER_ENABLED=true

# ---------------------------------------------------------------- 资源匹配
# 搜索到新资源时，系统会判断它属于哪部电影（匹配）。匹配结果按置信度分三档：
#   高于 AUTO 阈值 → 如果 AUTO_APPLY=true 就自动关联，否则只记录
#   介于 REVIEW 和 AUTO 之间 → 如果 SHADOW=true 就记到 /admin/matches 等人工审核，否则丢弃
#   低于 REVIEW 阈值 → 直接丢弃
#
# 推荐配置：SHADOW=false + AUTO_APPLY=true（自动关联高置信匹配，其余丢弃，不需要人工审核）
RESOURCE_MATCH_SHADOW=false
RESOURCE_MATCH_AUTO_APPLY=true
# 自动关联阈值，达到即认为是同一部影片
MEDIA_AUTO_MATCH_THRESHOLD=0.70
# 人工复核阈值，必须 > 0 且 < AUTO 阈值
MEDIA_REVIEW_MATCH_THRESHOLD=0.68

# ---------------------------------------------------------------- 热度快照
# 快照的构建与读取已固定启用（原 POPULARITY_SNAPSHOT_BUILD/READ 开关已移除）。
# 快照不可用时自动回退到豆瓣榜单。此处只控制重算周期（分钟）。
POPULARITY_REFRESH_MINUTES=30

# ---------------------------------------------------------------- 外部服务
# 电影剧照与向量增强。TMDB/Cloudflare 未配置时会安全降级；Ollama 保留旧站默认地址与模型。
# TMDB API v4 Bearer Token，用于拉取剧照、背景图和 IMDb ID。留空则跳过这部分补全。
TMDB_API_TOKEN=
# 本地 Ollama 服务地址，用于生成影片文本的向量（embedding）。结尾斜杠会被去掉。
OLLAMA_HOST=http://localhost:11434
# 生成向量使用的模型名，换模型会导致已有 embedding 维度不匹配，需要重算。
OLLAMA_MODEL=quentinz/bge-base-zh-v1.5
# Cloudflare AI Gateway 地址，用于 AI 摘要/推荐。留空则关闭该功能。
CF_GATEWAY_URL=
# Cloudflare API Token，配合 CF_GATEWAY_URL 使用。
CF_API_TOKEN=
# 经 Cloudflare Gateway 调用的模型名。
CF_AI_MODEL=custom-alibaba-coding/kimi-k2.5
# AI Gateway 请求超时（秒）。一次非流式 chat completion 常常要几十秒，
# 这里必须远大于 SEARCH_SOURCE_TIMEOUT_SECONDS，否则语义描述会全部超时并退回元数据。
CATALOG_AI_TIMEOUT_SECONDS=90
# 豆瓣→IMDb 映射由 imdb_backfill 任务补齐，TMDB 抓取本身不再查映射。
# Wikidata 一次查一批（豆瓣 ID 属性 P4529，IMDb ID 属性 P345），是主力来源；
# wmdb 只处理 Wikidata 查不到的残余，下面是它的最小发送间隔（毫秒）。
IMDB_LOOKUP_INTERVAL_MS=1200
# 单轮批量查询的对象数量。SPARQL 有 60 秒查询超时，批太大会整批失败。
IMDB_BACKFILL_BATCH=200
# SPARQL 端点。留空使用 https://query.wikidata.org/sparql。
WIKIDATA_SPARQL_URL=
# 维基媒体要求请求带上能说明来源和联系方式的 User-Agent，默认 UA 会被直接拒绝。
# 建议填成 站点名/版本 (联系邮箱)。
WIKIDATA_USER_AGENT=
# SPARQL 请求超时（秒），要覆盖 Wikidata 自身的查询超时。
WIKIDATA_TIMEOUT_SECONDS=60

# 启动时自动执行 internal/platform/database/migrations 下的表结构迁移。
# 注意这是 schema migration。
DB_AUTO_MIGRATE=true
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# 生产环境不要把真实密码提交进仓库，用受控的 secret 注入。
DB_PASSWORD=postgres
# 数据库名，必填。cmd/datamigrate 迁移的目标库名固定校验为 moovie_v2。
DB_NAME=moovie_new
# PostgreSQL SSL 模式：disable / require / verify-ca / verify-full。
DB_SSLMODE=disable
# 连接时区，影响 timestamp 的解释。
DB_TIMEZONE=Asia/Shanghai
# 连接池上限。硬上限 100；Web 建议 12、独立 Worker 建议 6，两者相加不要超过 PG 的 max_connections。
DB_MAX_CONNS=12

# ---------------------------------------------------------------- 安全
# 生产环境必须替换为至少 32 字节的随机值；production 同时要求 HTTPS SITE_URL。
# 用于签发 JWT 和会话；修改后所有已登录用户会被登出。
# 生成方式：openssl rand -base64 48
APP_SECRET=replace-with-a-long-random-secret
# 登录令牌有效期（小时），默认 72。
JWT_EXPIRY_HOURS=72

# 弹幕聚合服务（danmu_api），留空则整站关闭弹幕功能
# 地址必须带上 token 前缀。本地开发可指向 Cloudflare Workers 部署：
#   DANMU_API_BASE=https://danmu-api.xxx.workers.dev/moovie
# 生产走 docker compose 内网，DANMU_API_TOKEN 需与 compose 里的 TOKEN 一致：
DANMU_API_TOKEN=moovie
DANMU_API_BASE=http://danmu-api:9321/moovie

# ---------------------------------------------------------------- Docker 部署
# Docker Compose 默认同时启动 Web 与独立 Worker，且强制 Web 的 JOBS_IN_WEB=false。
# 两个进程必须指向同一独立新数据库；Web 默认 12 个连接、Worker 默认 6 个连接。
# 默认容器预算：Web 1GiB/GOMEMLIMIT 700MiB，Worker 512MiB/GOMEMLIMIT 320MiB；
# 按宿主机容量通过 WEB_* / WORKER_* 环境变量调整，但始终为 Go 堆保留总内存余量。
#
# 以下变量只被 docker-compose.yml 读取，不进入应用配置，按需取消注释：
# WEB_DB_MAX_CONNS=12           Web 容器的 DB_MAX_CONNS
# WEB_GO_MEMORY_LIMIT=700MiB    Web 容器的 GOMEMLIMIT，应低于 WEB_MEMORY_LIMIT
# WEB_GOMAXPROCS=2              Web 容器可用的 P 数量
# WEB_MEMORY_LIMIT=1g           Web 容器内存硬限制
# WEB_CPU_LIMIT=2.0             Web 容器 CPU 配额
# WORKER_DB_MAX_CONNS=6         Worker 容器的 DB_MAX_CONNS
# WORKER_GO_MEMORY_LIMIT=320MiB Worker 容器的 GOMEMLIMIT
# WORKER_GOMAXPROCS=1
# WORKER_MEMORY_LIMIT=512m
# WORKER_CPU_LIMIT=1.0
