# Server Configuration
PORT=5007
APP_ENV=development # development, production
SITE_NAME=Moovie影牛
SITE_URL=http://localhost:5007
# HTTP 响应写超时（秒）。必须显著大于采集侧的超时预算（单站 10s / 整轮 30s），
# 否则冷门词首次搜索会在响应写完前被截断，用户看到的是连接中断
HTTP_WRITE_TIMEOUT_SECONDS=30

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=moovie
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Shanghai

# Security
APP_SECRET=your-secret-key-change-in-production
JWT_EXPIRY_HOURS=72

# Ollama Embedding Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=quentinz/bge-base-zh-v1.5

# Crawler Configuration
DOUBAN_PROXY=None

# 采集站点熔断开关。连续 3 次超时/错误的站点会被暂时移出搜索候选（冷却 5 分钟，
# 期间放探针试探恢复），避免每次搜索都在挂掉的站上白等一个超时。
# 设为 false 则只统计健康度、不跳过任何站点。全部站点都熔断时会自动兜底放行。
SEARCH_BREAKER_ENABLED=true

# TMDB API Configuration
TMDB_API_TOKEN=your_tmdb_api_token_here

# Gemini 和 Cloudflare AI配置一个即可
# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# 弹幕聚合服务（danmu_api），留空则整站关闭弹幕功能。
#
# DANMU_API_TOKEN 是唯一需要你改的值，用随机字母数字，别用上游默认的 87654321。
# docker compose 会用它同时配置 danmu-api 容器的 TOKEN 和 app 的 DANMU_API_BASE，
# 两边自动对齐，不用手工同步。
DANMU_API_TOKEN=changeme

# DANMU_API_BASE 只在「不走 compose」时才需要手工填，例如本地开发直连 Workers 部署：
#   DANMU_API_BASE=https://danmu-api.xxx.workers.dev/moovie
# 生产用 docker compose 启动时，这一行会被 compose 里拼好的内网地址覆盖，可以留空。
DANMU_API_BASE=

# Cloudflare AI Gateway 配置
CF_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/你的账户id/你的应用名/compat
CF_API_TOKEN=你的Token
CF_AI_MODEL=custom-alibaba-coding/kimi-k2.5
